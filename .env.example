# Supabase Configuration
# Replace with your actual Supabase project credentials from your Supabase dashboard
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Fallback mode (set to true to use offline/demo simulated storage when Supabase is not yet configured)
VITE_USE_MOCK_FALLBACK=true

# Organization Settings
VITE_ORG_NAME="Smart Organization"
VITE_DEFAULT_TIMEZONE="Asia/Kolkata"
